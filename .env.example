# Copy this file to .env.local and fill in the value.
#
# Unsplash access key: create an app at https://unsplash.com/developers and copy
# its "Access Key" (the public Client ID, not the Secret Key).
#
# Server-side only: vite.config.ts reads it and attaches it to the Unsplash
# requests the dev server proxies, and server.js does the same in production.
# Do NOT rename it with a VITE_ prefix, which would inline the key into the
# browser bundle.
#
# On Railway, set this as a service variable instead of shipping a file.
UNSPLASH_ACCESS_KEY=
